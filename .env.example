# Copy to .env for local development. Never commit .env.
APP_ENV=development
APP_NAME=Clinical Trial Dashboard
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000

# PostgreSQL is the required runtime database for this project.
POSTGRES_DB=clinical_trials
POSTGRES_USER=clinical_app
POSTGRES_PASSWORD=replace_with_a_strong_local_password
DATABASE_URL=postgresql+psycopg://clinical_app:replace_with_a_strong_local_password@db:5432/clinical_trials
TEST_DATABASE_URL=postgresql+psycopg://clinical_app:replace_with_a_strong_local_password@db:5432/clinical_trials_test

# Generate a long random secret for local development; never use this placeholder.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Google Gemini. Keep empty to disable AI features during local development.
GEMINI_API_KEY=
GEMINI_MODEL=replace_with_a_supported_gemini_model_id

# Upload limits
MAX_UPLOAD_MB=10
MAX_CSV_ROWS=10000

# CORS: comma-separated origins, no wildcard in production.
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO
